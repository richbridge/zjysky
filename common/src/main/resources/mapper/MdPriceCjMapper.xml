<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjysky.common.database.mapper.MdPriceCjMapper">

    <resultMap id="MdPriceCjResult" type="com.zjysky.common.database.entity.MdPriceCj">
        <id column="id" property="id" />
        <result column="task_type" property="taskType" />
        <result column="product_id" property="productId" />
        <result column="product_name" property="productName" />
        <result column="quote_date" property="quoteDate" />
        <result column="avg_price" property="avgPrice" />
        <result column="high_price" property="highPrice" />
        <result column="low_price" property="lowPrice" />
        <result column="change_value" property="changeValue" />
        <result column="change_pct" property="changePct" />
        <result column="point_precision" property="pointPrecision" />
        <result column="raw_json" property="rawJson" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <select id="findTodayData" resultMap="MdPriceCjResult">
        SELECT * FROM md_price_cj WHERE quote_date = #{date}
    </select>

    <!-- 唯一键 (task_type, quote_date, product_id) -->
    <insert id="upsertBatch">
        INSERT INTO md_price_cj
(task_type, product_id, product_name, quote_date,
         avg_price, high_price, low_price, change_value, change_pct,
         point_precision, raw_json)
        VALUES
<foreach collection="list" item="it" separator=",">
            (#{it.taskType}, #{it.productId}, #{it.productName}, #{it.quoteDate},
             #{it.avgPrice}, #{it.highPrice}, #{it.lowPrice},
             #{it.changeValue}, #{it.changePct}, #{it.pointPrecision}, #{it.rawJson})
        </foreach>
ON DUPLICATE KEY UPDATE
            product_name    = VALUES(product_name),
            avg_price       = VALUES(avg_price),
            high_price      = VALUES(high_price),
            low_price       = VALUES(low_price),
            change_value    = VALUES(change_value),
            change_pct      = VALUES(change_pct),
            point_precision = VALUES(point_precision),
            raw_json        = VALUES(raw_json),
            update_time     = CURRENT_TIMESTAMP
    </insert>

</mapper>
