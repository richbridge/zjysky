<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjysky.common.database.mapper.SysMenuMapper">

    <!-- 通用 CRUD 由 MyBatis-Plus BaseMapper 提供，此处只放菜单装配用的全量查询 -->
    <select id="listAll" resultType="com.zjysky.common.database.entity.SysMenu">
        SELECT id, parent_id, menu_key, title, path, component,
               sort_no, visible, closable, create_time, update_time
        FROM sys_menu
        ORDER BY parent_id, sort_no, id
    </select>

</mapper>
